# Salin file ini menjadi .env lalu isi nilai sebenarnya.
# .env TIDAK boleh di-commit ke Git (sudah ada di .gitignore).

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=padi_pjok
DB_USER=padi_user
DB_PASS=ganti_dengan_password_kuat

# --- Aplikasi ---
APP_TZ=Asia/Jakarta
APP_URL=https://padipjok.pintarhub.com
APP_ENV=production

# --- Keamanan (opsional tapi disarankan) ---
# Password awal akun guru `guru` saat tabel guru masih kosong / masih memakai
# password lama `guru123`. Bila kosong, password acak dibuat dan ditulis ke
# padi-guru-password.txt satu tingkat di atas document root.
GURU_SEED_PASS=

# Token installer (min. 20 karakter). Installer hanya bisa dibuka lewat
# /instal/<token> ; tanpa nilai ini installer nonaktif sepenuhnya.
PADI_SETUP_TOKEN=
