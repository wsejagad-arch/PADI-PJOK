# Salin file ini menjadi .env lalu isi nilai sebenarnya.
# .env TIDAK boleh di-commit ke Git (sudah ada di .gitignore).

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=padi_pjok
DB_USER=padi_user
DB_PASS=ganti_dengan_password_kuat

# --- Aplikasi ---
APP_TZ=Asia/Jakarta
APP_URL=https://padipjok.pintarhub.com
APP_ENV=production

# --- Keamanan (opsional tapi disarankan) ---
# Password awal akun guru `guru` saat tabel guru masih kosong / masih memakai
# password lama `guru123`. Bila kosong, password acak dibuat dan ditulis ke
# padi-guru-password.txt satu tingkat di atas document root.
GURU_SEED_PASS=

# Token installer (min. 20 karakter). Installer hanya bisa dibuka lewat
# /instal/<token> ; tanpa nilai ini installer nonaktif sepenuhnya.
PADI_SETUP_TOKEN=

# --- Identitas sekolah untuk kop cetak/PDF (ui-cetak.php) ---
# Baris instansi di atas nama sekolah, mis. PEMERINTAH PROVINSI JAWA TIMUR
SEKOLAH_INSTANSI=
# Nama sekolah, mis. SMAN 1 SUMBER
SEKOLAH_NAMA=
# Alamat singkat + NPSN, mis. Jl. Raya Sumber No. 1, Malang
SEKOLAH_ALAMAT=
SEKOLAH_NPSN=
# Kota/kabupaten untuk baris tanggal tanda tangan
SEKOLAH_KOTA=
# Tahun pelajaran, mis. 2026/2027
TAHUN_PELAJARAN=
# Nama & NIP kepala sekolah (kolom kiri tanda tangan)
KEPALA_SEKOLAH=
KEPALA_SEKOLAH_NIP=
# NIP guru mapel PJOK (nama diambil dari akun guru yang login)
GURU_NIP=

# --- Multi-tenant (beberapa sekolah dalam satu instalasi) ---
# Domain induk; subdomain = slug sekolah (mis. sman1.<BASE_DOMAIN>).
# Kosongkan bila hanya memakai satu domain (semua akses ke sekolah default).
BASE_DOMAIN=
# Slug sekolah default (dipakai saat host tidak punya subdomain sekolah)
TENANT_DEFAULT=utama

# --- Login guru dengan akun Belajar.id (Google OAuth 2.0) ---
# Buat OAuth Client (Web application) di Google Cloud Console, lalu daftarkan
# redirect URI: https://<domain>/oauth-callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional; bila kosong dihitung otomatis dari host + /oauth-callback.php
GOOGLE_REDIRECT_URI=
# Domain email yang diizinkan (pisah koma; dukung pola *.sch.id)
BELAJAR_ID_DOMAIN=belajar.id
# 1 = guru dengan email terdaftar otomatis dibuatkan akun di sekolah aktif
BELAJAR_ID_AUTO_DAFTAR=1
# Opsional: batasi halaman consent Google ke satu domain (mis. belajar.id)
BELAJAR_ID_HD=
